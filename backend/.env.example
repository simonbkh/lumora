# ─── Application ─────────────────────────────────────────────────────────────
APP_NAME=Lumora
APP_ENV=development           # development | staging | production
DEBUG=true
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
API_V1_PREFIX=/api/v1

# ─── Database ─────────────────────────────────────────────────────────────────
POSTGRES_USER=lumora
POSTGRES_PASSWORD=lumora_secret
POSTGRES_DB=lumora_db
POSTGRES_HOST=db              # use 'localhost' when running outside Docker
POSTGRES_PORT=5434
DATABASE_URL=postgresql+asyncpg://lumora:lumora_secret@db:5432/lumora_db

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ─── Pagination ───────────────────────────────────────────────────────────────
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
